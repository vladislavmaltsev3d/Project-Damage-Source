--- /dev/null
+++ b/project_damage source/native_core.py	
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Load the compiled geometry core under the add-on's package name."""
+from importlib.machinery import EXTENSION_SUFFIXES
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+import sys
+
+MODULE_NAME = "project_damage_core_py"
+
+
+def binary_path(directory):
+    for suffix in EXTENSION_SUFFIXES:
+        path = Path(directory) / (MODULE_NAME + suffix)
+        if path.is_file():
+            return path
+    return None
+
+
+def loaded(package):
+    return sys.modules.get(f"{package}.{MODULE_NAME}")
+
+
+def load(package, path):
+    module = loaded(package)
+    if module is not None:
+        return module
+
+    # The final name component still matches the compiled PyInit_* symbol.
+    name = f"{package}.{MODULE_NAME}"
+    spec = spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Cannot load {name} from {path}")
+    module = module_from_spec(spec)
+    sys.modules[name] = module
+    try:
+        spec.loader.exec_module(module)
+    except BaseException:
+        sys.modules.pop(name, None)
+        raise
+    return module
