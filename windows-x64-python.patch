+        return
+
+    def draw(self, _context):
+        self.layout.label(text='Hit update to refresh result')
+
+    windows = [w for w in wm.windows if w.scene == context.scene]
+    windows.sort(key=lambda w: w != context.window)
+    for window in windows:
+        areas = [a for a in window.screen.areas if a.type == 'VIEW_3D']
+        areas.sort(key=lambda a: a != context.area)
+        for area in areas:
+            region = next((r for r in area.regions if r.type == 'WINDOW'), None)
+            if region is not None:
+                try:
+                    with context.temp_override(window=window, area=area, region=region):
+                        wm.popup_menu(draw, title='Live Update is Disabled', icon='INFO')
+                except (ReferenceError, RuntimeError):
+                    continue
+                return
