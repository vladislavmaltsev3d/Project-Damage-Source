-def _bezier(p0, p1, p2, p3, t):
-    u = 1.0 - t
-    return ((u * u * u)[:, None] * p0 + (3 * u * u * t)[:, None] * p1 + (3 * u * t * t)[:, None] * p2
-            + (t * t * t)[:, None] * p3)
