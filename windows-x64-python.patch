+def draw_dev_tools(self, context):
+    from project_damage import sidebar
+    layout = self.layout
+    layout.operator('project_damage.export_dev_settings', text='Save All Settings for AI', icon='EXPORT')
+    src, key = dev_tools.selected(context)
+    if key is None:
